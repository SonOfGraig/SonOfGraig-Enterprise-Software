# SonOfGraig Enterprise Software — environment variables
# Copy this file to `.env.local` for local development.
# Production values are injected by Cloud Run / Secret Manager.

# APP_URL: Public URL of the deployed application.
# Used in absolute links, OG metadata, and form callback URLs.
# Production: set automatically on Cloud Run after first deploy.
# Local dev: leave unset to default to http://localhost:3000.
# APP_URL=https://your-deployment.run.app

# (Forms integration with Supabase + Resend lands in Phase C — env vars added then.)
