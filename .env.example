# SonOfGraig Enterprise Software — environment variables
# Copy this file to `.env.local` for local development.
# Production values are injected by Cloud Run / Secret Manager.

# NEXT_PUBLIC_SITE_URL: Canonical public URL — drives sitemap, robots,
# OG metadata, JSON-LD @id values, and absolute links. Set this to the
# real domain in production so search engines and AI crawlers do not
# index the Cloud Run hostname instead of sonofgraig.com.
# NEXT_PUBLIC_SITE_URL=https://sonofgraig.com

# APP_URL: Legacy fallback for absolute links. NEXT_PUBLIC_SITE_URL wins
# when both are set. Kept for backwards compatibility with form callbacks.
# APP_URL=https://your-deployment.run.app

# ──────────────────────────────────────────────────────────────────────────
# Forms (Phase C)
# ──────────────────────────────────────────────────────────────────────────

# Resend API key. Generate at https://resend.com/api-keys with "Sending access"
# permission restricted to the sonofgraig.com domain.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# From address for outbound mail. Must be on a verified Resend domain.
# RESEND_FROM_EMAIL=sonofgraig <noreply@sonofgraig.com>

# Cloudflare Turnstile keys. Site key is exposed to the browser (NEXT_PUBLIC_).
# Secret key is server-only — never expose. Generate at:
# https://dash.cloudflare.com/?to=/:account/turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
# TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxx_secret

# ──────────────────────────────────────────────────────────────────────────
# Analytics
# ──────────────────────────────────────────────────────────────────────────

# Google Analytics 4 measurement ID. Get one at https://analytics.google.com
# (Admin → Data Streams → Web → Measurement ID). Format: G-XXXXXXXXXX
# Leave unset to disable analytics entirely (no script injected).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ──────────────────────────────────────────────────────────────────────────
# PageSpeed Insights audits (local tooling only — NOT used by the app runtime)
# ──────────────────────────────────────────────────────────────────────────

# Google PageSpeed Insights API key for `npm run audit:speed`. Optional — the
# API works unauthenticated at a low quota, but a key raises the rate limit.
# Enable the API first:
#   gcloud services enable pagespeedonline.googleapis.com --project=gen-lang-client-0731037145
# Then create a key (Console → APIs & Services → Credentials) and put it in
# .env.local (NOT .env.example — never commit a real key):
# PAGESPEED_API_KEY=AIza...
